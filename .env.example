# ─────────────────────────────────────────────────────────────────────────────
# Bunker Desk — environment variable template
# Copy to .env.local and fill in the keys you have. Every key is OPTIONAL:
# adapters without a key degrade to an honest "API key not configured" state
# rather than fabricating data. Keys are read SERVER-SIDE ONLY (app/api/*).
# ─────────────────────────────────────────────────────────────────────────────

# ── Tier 1: Live API sources ────────────────────────────────────────────────

# EIA v2 — crude & refined-product spot prices, refining stats. FREE, instant.
# Register: https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# FRED (St. Louis Fed) — crude, macro, FX indices, rates. FREE.
# Register: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# AlphaVantage — WTI/Brent/NatGas commodities, FX, equities. FREEMIUM (~25/day).
# Register: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# TwelveData — quotes, FX, ETFs. FREEMIUM (~800/day).
# Register: https://twelvedata.com/pricing
TWELVEDATA_API_KEY=

# OpenWeather — chokepoint weather/wind. FREEMIUM (60/min, 1M/mo).
# Register: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Stooq (WTI/Brent/FX CSV) and ECB (EUR FX) need NO key — always available.

# ── Supabase — provenance audit trail / persisted history ────────────────────
# Publishable (anon) key + project URL. These are PUBLIC by design (NEXT_PUBLIC_).
# Run supabase/migrations/0001_metric_snapshots.sql once in the SQL editor first.
# Leaving these blank disables the audit trail; the platform degrades honestly.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# Optional production hardening: server-side writes with the service role key.
SUPABASE_SERVICE_ROLE_KEY=

# ── Tier 3: Controlled scraping (DISABLED by default) ────────────────────────
# Leave false unless you have cleared each connector's robots.txt + ToS gate.
SCRAPING_ENABLED=false

# ── Tier 4: Commercial integrations (stubs; supply when you license them) ─────
ARGUS_API_KEY=
PLATTS_API_KEY=
CLARKSONS_API_KEY=
KPLER_API_KEY=
VORTEXA_API_KEY=
SIGNAL_OCEAN_API_KEY=
BALTIC_API_KEY=
MARINETRAFFIC_API_KEY=
